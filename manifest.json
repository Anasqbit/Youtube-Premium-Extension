{
  "manifest_version": 3,
  "author": "Anasqbit",
  "name": "__MSG_extName__",
  "default_locale": "en",
  "version": "2.0",
  "description": "__MSG_extDescription__",
  "action": {
    "default_icon": "icons/icon128.png",
    "default_title": "__MSG_extName__",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://returnyoutubedislikeapi.com/*",
    "*://*.any4k.com/*",
    "*://any4k.com/*",
    "*://www.myinstants.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://youtube.com/*",
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "exclude_matches": [
        "*://music.youtube.com/*",
        "*://*.music.youtube.com/*"
      ],
      "js": [
        "main.js",
        "scripts/premium-logo.js",
        "scripts/speed-controller.js",
        "scripts/return-dislike.js",
        "scripts/downloader.js"
      ],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}